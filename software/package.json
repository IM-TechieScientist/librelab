{
  "name": "librelab-studio",
  "version": "0.1.0",
  "description": "Modern desktop control and analysis software for LibreLab instruments",
  "main": "./out/main/index.js",
  "author": "FOSSASIA",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts --port 5174",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "docs:screenshots": "node scripts/capture-doc-screenshots.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "28.1.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "build": {
    "appId": "org.fossasia.librelab.studio",
    "productName": "LibreLab Studio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
